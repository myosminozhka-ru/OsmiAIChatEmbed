# =============================================================================
# Osmi AI Chat Embed — proxy server environment variables
# =============================================================================
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# The server exits on startup if API_HOST, CHATBOT_API_KEY, or at least one
# valid chatflow entry is missing.
# =============================================================================


# -----------------------------------------------------------------------------
# Required — backend connection
# -----------------------------------------------------------------------------

# Base URL of your Osmi AI / Flowise chatbot backend (no trailing slash).
# All API requests from this proxy are forwarded to this host.
# Example: https://your-chatbot-instance.com
API_HOST=

# API key from the chatbot backend settings page.
# Used server-side only; never expose it in the browser embed.
# Example: OxxGE-h_LaH7ZYorStjTOik1XY999RxxoHpCSYl8BXxc
CHATBOT_API_KEY=


# -----------------------------------------------------------------------------
# Required — chatflow mappings (at least one)
# -----------------------------------------------------------------------------
# Any env var that is NOT listed in server.js as "reserved" is treated as a
# chatflow identifier. Use the identifier as chatflowid in Chatbot.init().
#
# Format:
#   IDENTIFIER=CHATFLOW_UUID,ALLOWED_ORIGIN_1,ALLOWED_ORIGIN_2,...
#
#   IDENTIFIER     — arbitrary name (e.g. agent1, support); case-insensitive
#   CHATFLOW_UUID  — UUID of the chatflow in the backend
#   ALLOWED_ORIGIN — full origin where embedding is allowed (scheme + host + port)
#
# Rules:
#   - Wildcard (*) domains are rejected
#   - In non-production (NODE_ENV != production), http://localhost:5678 is
#     always allowed in addition to domains you list
#   - Whitelist the proxy URL too if you load web.js from it (e.g.
#     http://localhost:3001 or https://your-proxy.example.com)
#
# Examples:
# agent1=20db97c6-64c9-4411-bab4-7d6202171600,https://example.com
# support=1c28f529-a70f-5001-9bc5-4f4c5d03d8c0,https://app.example.com,https://www.example.com

agent1=
# support=


# -----------------------------------------------------------------------------
# Optional — HTTP server
# -----------------------------------------------------------------------------

# Port the proxy listens on (default: 3001)
PORT=3001

# Bind address (default: 0.0.0.0 — all interfaces)
HOST=0.0.0.0

# When set to any non-empty value, startup logs use an HTTPS base URL built from
# HOST (https://HOST) for embed script examples. When unset and NODE_ENV is not
# production, logs use http://localhost:PORT instead.
# Example: 1
BASE_URL=

# development | production
# - production: no extra default allowed domain (only domains you configure)
# - development: http://localhost:5678 is auto-allowed for each chatflow
# Also affects which URL is printed for embed snippets (see BASE_URL).
NODE_ENV=development
